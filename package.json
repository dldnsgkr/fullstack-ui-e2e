{
  "name": "guestbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Guestbook (projectId=42): a single Node server exposing a guestbook API backed by MySQL and serving the React frontend",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "check": "node --check server/index.js && node --check server/db.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
